# Neon Postgres connection string from the Neon dashboard.
# Example: postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
# Optional alias
# NEON_DATABASE_URL=

# mock = no charge, no keys needed. live = real Stripe Checkout + webhook.
STRIPE_MODE=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MOCK_WEBHOOK_SECRET=dev-mock-secret

# candidate | employer
FEE_PAYER_MODE=candidate

# recruiter dashboard token — REQUIRED in production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# Transactional email (Resend)
RESEND_API_KEY=
EMAIL_FROM="Meridian Aviation Academy <no-reply@meridianaviationacademy.com>"
ADMIN_NOTIFY_EMAIL=

# Public site URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel Blob for candidate documents (optional)
BLOB_READ_WRITE_TOKEN=
