# Turso / libSQL connection. Create a database at https://turso.tech and copy
# the URL and auth token from the dashboard (turso db show / turso db tokens create).
TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
TURSO_AUTH_TOKEN=
# Legacy alias — lib/db.ts also accepts DATABASE_URL if TURSO_DATABASE_URL is unset.
# DATABASE_URL=libsql://your-db-your-org.turso.io
# mock | live (mock = clearly-labelled demo, no real charge)
STRIPE_MODE=mock
MOCK_WEBHOOK_SECRET=dev-mock-secret
# deferred | mock-employer | mock-candidate — decide payer before launch, no code change
FEE_PAYER_MODE=deferred
# recruiter dashboard token — REQUIRED in production. Leave empty only for local dev.
# Without it, /admin and the admin APIs deny access to everyone (fail-closed).
# Generate a strong value, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=
# --- Transactional email (Resend) — REQUIRED in production ---
# Get a key at https://resend.com and verify your sending domain.
# Without a key, emails are only logged to the console and applicants receive nothing.
RESEND_API_KEY=
# Verified sender, e.g. "Meridian Aviation Academy <no-reply@yourdomain.com>"
EMAIL_FROM="Meridian Aviation Academy <onboarding@resend.dev>"
# Recruiter inbox that receives payment/approval notifications
ADMIN_NOTIFY_EMAIL=
# Public site URL used in links, metadata, sitemap and robots
NEXT_PUBLIC_APP_URL=http://localhost:3000
